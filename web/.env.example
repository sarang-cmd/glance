# Public origin of the deployed site. Used for canonical URLs, OG images,
# sitemap.xml, the release-list origin check and links inside emails.
# Required in production. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://glance-win.vercel.app

# Neon Postgres connection string for the release list ONLY.
# Get it from your Neon project (pooled connection recommended).
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Resend. RESEND_API_KEY from resend.com, RESEND_FROM a verified sender.
# Without your own verified domain, "Glance <onboarding@resend.dev>" works for testing.
RESEND_API_KEY=re_xxxxxxxxxxxx
RESEND_FROM=Glance <onboarding@resend.dev>

# Optional. PostHog is loaded only after explicit consent, and only if this is set.
NEXT_PUBLIC_POSTHOG_KEY=phc_xxxxxxxxxxxx
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
